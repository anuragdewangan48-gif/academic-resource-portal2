# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Atlas connection string (or local mongodb://).
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/academic_portal?retryWrites=true&w=majority
# When omitted, the app automatically runs in resilient in-memory fallback mode with full functionality.
MONGODB_URI=""

# ADMIN_SECRET_KEY: Secret key required for /api/admin/* administrative endpoints.
# Default: academia-admin-secret-2026
ADMIN_SECRET_KEY="academia-admin-secret-2026"
